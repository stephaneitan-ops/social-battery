<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="10:08:32" />

    <!-- Réglage dans Personnaliser : afficher l'heure ou non -->
    <UserConfigurations>
        <BooleanConfiguration id="showTime" displayName="show_time" defaultValue="TRUE" />
    </UserConfigurations>

    <Scene backgroundColor="#FF000000">

        <!-- Badge en couleur, fourni par l'appli ; au repos (AOD) il reste affiché, atténué -->
        <ComplicationSlot slotId="0" x="0" y="0" width="450" height="450"
            supportedTypes="PHOTO_IMAGE" isCustomizable="TRUE">
            <DefaultProviderPolicy
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="PHOTO_IMAGE"
                primaryProvider="fr.stephane.socialbattery/fr.stephane.socialbattery.BatteryComplicationService"
                primaryProviderType="PHOTO_IMAGE" />
            <BoundingOval x="0" y="0" width="450" height="450" />
            <Complication type="PHOTO_IMAGE">
                <PartImage x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="170" />
                    <Image resource="[COMPLICATION.PHOTO_IMAGE]" />
                </PartImage>
            </Complication>
        </ComplicationSlot>

        <BooleanConfiguration id="showTime">
            <BooleanOption id="TRUE">
                <!-- Heure en petit, entre l'emoji et la phrase du bas -->
                <DigitalClock x="125" y="282" width="200" height="46">
                    <TimeText format="hh:mm" hourFormat="24" align="CENTER" x="0" y="0" width="200" height="46">
                        <Font family="SYNC_TO_DEVICE" size="36" weight="BOLD" color="#FFFFFFFF" />
                    </TimeText>
                </DigitalClock>
            </BooleanOption>
        </BooleanConfiguration>
    </Scene>
</WatchFace>
