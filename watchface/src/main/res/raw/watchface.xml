<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="10:08:32" />

    <Scene backgroundColor="#FF000000">

        <!-- Écran actif : badge complet en couleur, fourni par l'appli -->
        <Group name="badge" x="0" y="0" width="450" height="450" alpha="255">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <ComplicationSlot slotId="0" x="0" y="0" width="450" height="450"
                supportedTypes="PHOTO_IMAGE" isCustomizable="TRUE">
                <DefaultProviderPolicy
                    defaultSystemProvider="EMPTY"
                    defaultSystemProviderType="EMPTY"
                    primaryProvider="fr.stephane.socialbattery/fr.stephane.socialbattery.BatteryComplicationService"
                    primaryProviderType="PHOTO_IMAGE" />
                <BoundingOval x="0" y="0" width="450" height="450" />
                <Complication type="PHOTO_IMAGE">
                    <PartImage x="0" y="0" width="450" height="450">
                        <Image resource="[COMPLICATION.PHOTO_IMAGE]" />
                    </PartImage>
                </Complication>
            </ComplicationSlot>
        </Group>

        <!-- Écran au repos (AOD) : fond noir, juste le mot du niveau -->
        <Group name="ambient" x="0" y="0" width="450" height="450" alpha="0">
            <Variant mode="AMBIENT" target="alpha" value="255" />
            <ComplicationSlot slotId="1" x="75" y="150" width="300" height="80"
                supportedTypes="SHORT_TEXT" isCustomizable="TRUE">
                <DefaultProviderPolicy
                    defaultSystemProvider="EMPTY"
                    defaultSystemProviderType="EMPTY"
                    primaryProvider="fr.stephane.socialbattery/fr.stephane.socialbattery.BatteryComplicationService"
                    primaryProviderType="SHORT_TEXT" />
                <BoundingBox x="0" y="0" width="300" height="80" />
                <Complication type="SHORT_TEXT">
                    <PartText x="0" y="0" width="300" height="80">
                        <Text align="CENTER">
                            <Font family="SYNC_TO_DEVICE" size="48" weight="BOLD" color="#FFFFFFFF">
                                <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                            </Font>
                        </Text>
                    </PartText>
                </Complication>
            </ComplicationSlot>
        </Group>

        <!-- Heure en petit, entre l'emoji et la phrase du bas -->
        <DigitalClock x="125" y="282" width="200" height="46">
            <TimeText format="HH:mm" align="CENTER" x="0" y="0" width="200" height="46">
                <Font family="SYNC_TO_DEVICE" size="36" weight="BOLD" color="#FFFFFFFF" />
            </TimeText>
        </DigitalClock>
    </Scene>
</WatchFace>
