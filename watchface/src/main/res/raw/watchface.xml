<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="10:08:32" />

    <!-- Réglage dans Personnaliser : afficher l'heure ou non -->
    <UserConfigurations>
        <BooleanConfiguration id="showTime" displayName="show_time" defaultValue="TRUE" />
    </UserConfigurations>

    <Scene backgroundColor="#FF000000">

        <!-- Badge dessiné par le cadran, selon le niveau (0 à 3) envoyé par l'appli -->
        <ComplicationSlot slotId="0" x="0" y="0" width="450" height="450"
            supportedTypes="RANGED_VALUE" isCustomizable="TRUE">
            <DefaultProviderPolicy
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="RANGED_VALUE"
                primaryProvider="fr.stephane.socialbattery/fr.stephane.socialbattery.BatteryComplicationService"
                primaryProviderType="RANGED_VALUE" />
            <BoundingOval x="0" y="0" width="450" height="450" />
            <Complication type="RANGED_VALUE">
                <Group name="badge" x="0" y="0" width="450" height="450" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="170" />
                    <Condition>
                        <Expressions>
                            <Expression name="lvl0"><![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] == 0]]></Expression>
                            <Expression name="lvl1"><![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] == 1]]></Expression>
                            <Expression name="lvl2"><![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] == 2]]></Expression>
                        </Expressions>
                        <Compare expression="lvl0">
                            <Group name="happy" x="0" y="0" width="450" height="450">
                                <PartDraw x="0" y="0" width="450" height="450">
                                    <Ellipse x="0" y="0" width="450" height="450">
                                        <Fill color="#FF2ECC9A" />
                                    </Ellipse>
                                </PartDraw>
                                <PartText x="0" y="0" width="450" height="450">
                                    <TextCircular centerX="225" centerY="225" width="300" height="300" startAngle="270" endAngle="450" direction="CLOCKWISE" align="CENTER">
                                        <Font family="SYNC_TO_DEVICE" size="54" weight="BOLD" color="#FFFFFFFF">HAPPY</Font>
                                    </TextCircular>
                                </PartText>
                                <PartText x="0" y="0" width="450" height="450">
                                    <TextCircular centerX="225" centerY="225" width="370" height="370" startAngle="240" endAngle="120" direction="COUNTER_CLOCKWISE" align="CENTER">
                                        <Font family="SYNC_TO_DEVICE" size="34" weight="BOLD" color="#FFFFFFFF">TALK TO ME!</Font>
                                    </TextCircular>
                                </PartText>
                                <PartText x="75" y="110" width="300" height="160">
                                    <Text align="CENTER">
                                        <Font family="SYNC_TO_DEVICE" size="120" color="#FFFFFFFF">😊</Font>
                                    </Text>
                                </PartText>
                            </Group>
                        </Compare>
                        <Compare expression="lvl1">
                            <Group name="ok" x="0" y="0" width="450" height="450">
                                <PartDraw x="0" y="0" width="450" height="450">
                                    <Ellipse x="0" y="0" width="450" height="450">
                                        <Fill color="#FF3B8EEA" />
                                    </Ellipse>
                                </PartDraw>
                                <PartText x="0" y="0" width="450" height="450">
                                    <TextCircular centerX="225" centerY="225" width="300" height="300" startAngle="270" endAngle="450" direction="CLOCKWISE" align="CENTER">
                                        <Font family="SYNC_TO_DEVICE" size="54" weight="BOLD" color="#FFFFFFFF">OK</Font>
                                    </TextCircular>
                                </PartText>
                                <PartText x="0" y="0" width="450" height="450">
                                    <TextCircular centerX="225" centerY="225" width="370" height="370" startAngle="240" endAngle="120" direction="COUNTER_CLOCKWISE" align="CENTER">
                                        <Font family="SYNC_TO_DEVICE" size="34" weight="BOLD" color="#FFFFFFFF">SMALL TALK ONLY</Font>
                                    </TextCircular>
                                </PartText>
                                <PartText x="75" y="110" width="300" height="160">
                                    <Text align="CENTER">
                                        <Font family="SYNC_TO_DEVICE" size="120" color="#FFFFFFFF">🙂</Font>
                                    </Text>
                                </PartText>
                            </Group>
                        </Compare>
                        <Compare expression="lvl2">
                            <Group name="bored" x="0" y="0" width="450" height="450">
                                <PartDraw x="0" y="0" width="450" height="450">
                                    <Ellipse x="0" y="0" width="450" height="450">
                                        <Fill color="#FFF2A21B" />
                                    </Ellipse>
                                </PartDraw>
                                <PartText x="0" y="0" width="450" height="450">
                                    <TextCircular centerX="225" centerY="225" width="300" height="300" startAngle="270" endAngle="450" direction="CLOCKWISE" align="CENTER">
                                        <Font family="SYNC_TO_DEVICE" size="54" weight="BOLD" color="#FFFFFFFF">BORED</Font>
                                    </TextCircular>
                                </PartText>
                                <PartText x="0" y="0" width="450" height="450">
                                    <TextCircular centerX="225" centerY="225" width="370" height="370" startAngle="240" endAngle="120" direction="COUNTER_CLOCKWISE" align="CENTER">
                                        <Font family="SYNC_TO_DEVICE" size="34" weight="BOLD" color="#FFFFFFFF">I&apos;M SO DONE</Font>
                                    </TextCircular>
                                </PartText>
                                <PartText x="75" y="110" width="300" height="160">
                                    <Text align="CENTER">
                                        <Font family="SYNC_TO_DEVICE" size="120" color="#FFFFFFFF">😒</Font>
                                    </Text>
                                </PartText>
                            </Group>
                        </Compare>
                        <Default>
                            <Group name="drained" x="0" y="0" width="450" height="450">
                                <PartDraw x="0" y="0" width="450" height="450">
                                    <Ellipse x="0" y="0" width="450" height="450">
                                        <Fill color="#FFE5484D" />
                                    </Ellipse>
                                </PartDraw>
                                <PartText x="0" y="0" width="450" height="450">
                                    <TextCircular centerX="225" centerY="225" width="300" height="300" startAngle="270" endAngle="450" direction="CLOCKWISE" align="CENTER">
                                        <Font family="SYNC_TO_DEVICE" size="54" weight="BOLD" color="#FFFFFFFF">DRAINED</Font>
                                    </TextCircular>
                                </PartText>
                                <PartText x="0" y="0" width="450" height="450">
                                    <TextCircular centerX="225" centerY="225" width="370" height="370" startAngle="240" endAngle="120" direction="COUNTER_CLOCKWISE" align="CENTER">
                                        <Font family="SYNC_TO_DEVICE" size="34" weight="BOLD" color="#FFFFFFFF">LEAVE ME ALONE</Font>
                                    </TextCircular>
                                </PartText>
                                <PartText x="75" y="110" width="300" height="160">
                                    <Text align="CENTER">
                                        <Font family="SYNC_TO_DEVICE" size="120" color="#FFFFFFFF">😩</Font>
                                    </Text>
                                </PartText>
                            </Group>
                        </Default>
                    </Condition>
                </Group>
            </Complication>
        </ComplicationSlot>

        <BooleanConfiguration id="showTime">
            <BooleanOption id="TRUE">
                <!-- Heure en petit, entre l'emoji et la phrase du bas -->
                <DigitalClock x="125" y="282" width="200" height="46">
                    <TimeText format="hh:mm" hourFormat="24" align="CENTER" x="0" y="0" width="200" height="46">
                        <Font family="SYNC_TO_DEVICE" size="36" weight="BOLD" color="#FFFFFFFF" />
                    </TimeText>
                </DigitalClock>
            </BooleanOption>
        </BooleanConfiguration>
    </Scene>
</WatchFace>
